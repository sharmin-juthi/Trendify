# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/trendify
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/trendify
MONGO_URI=mongodb://127.0.0.1:27017/trendify

# JWT Authentication Secret
JWT_SECRET=trendify_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
